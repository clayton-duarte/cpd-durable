{
  "name": "cpd-durable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"vp dev\" \"tsx watch --env-file-if-exists=.env src/server/index.ts\"",
    "check": "vp check && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "tsc": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "lint": "vp lint",
    "fmt": "vp fmt --check",
    "test": "vp test run",
    "test:browser": "playwright test",
    "build": "vp build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "@assistant-ui/react-markdown": "0.14.26",
    "@base-ui/react": "1.9.0",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@fontsource-variable/geist": "5.3.0",
    "@hono/node-server": "^2.1.8",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "hono": "^4.13.19",
    "lucide-react": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.14",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/strictest": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.21.0"
}
